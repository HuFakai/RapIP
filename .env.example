# RapIP 配置文件（中文说明）
# 一键部署：bash scripts/deploy.sh；首次自动生成独立凭据并选择空闲端口。
# 手工部署：复制为 .env，替换三个 replace-with 占位值后再启动 Docker。
# 本文件是公开模板；.env 含真实凭据，只保存在服务器，不提交到 Git。
# 值中含 $ 或 #、空格时请用单引号包住，避免 Compose 插值或注释解析。

# ---------- 管理与代理认证 ----------
# 管理页面的登录用户名。与下方代理基础用户名是两个独立配置。
RAPIP_ADMIN_USER=admin
# 管理页面登录密码。一键部署生成 48 位随机字母数字，请勿保留示例值。
RAPIP_ADMIN_PASSWORD=replace-with-a-long-random-password
# SOCKS5 和 HTTP 代理的基础用户名；1–64 个 ASCII 字母或数字。
# 客户端完整用户名示例：admin-worker-01-session-a1b2c3。
RAPIP_SOCKS_USER=admin
# 两个代理入口共用的密码，不能使用管理员密码或供应商 Key 代替。
RAPIP_SOCKS_PASSWORD=replace-with-a-different-random-password
# 管理 API 的脚本凭据，调用时使用 Authorization: Bearer <此值>。
# 与管理员密码、代理密码分别生成；无需脚本接入时仍需配置。
RAPIP_ADMIN_TOKEN=replace-with-a-random-script-token
# 可选：Webshare API Key。推荐启动后在“上游账号”页面添加，此处可留空。
# 仅在 accounts.json 的 api_key_env=WEBSHARE_API_KEY 时使用本参数。
WEBSHARE_API_KEY=

# ---------- 三个入口的监听地址与端口 ----------
# 管理页面/API 的原生监听地址；Docker 内由 Compose 固定为 0.0.0.0。
RAPIP_HTTP_HOST=127.0.0.1
# 管理端口；同时控制 Docker 容器监听、宿主机映射及健康检查。
# 一键部署首次自动挑选空闲高端口；手工部署默认 8080。
RAPIP_HTTP_PORT=8080
# SOCKS5 的原生监听地址；Docker 内由 Compose 固定为 0.0.0.0。
RAPIP_SOCKS_HOST=127.0.0.1
# SOCKS5 TCP 端口；一键部署自动挑选；不得与其他两个入口相同。
RAPIP_SOCKS_PORT=1080
# HTTP/HTTPS CONNECT 代理的原生监听地址；容器内固定为 0.0.0.0。
RAPIP_PROXY_HTTP_HOST=127.0.0.1
# HTTP 代理 TCP 端口；HTTPS 目标也使用此入口，经 CONNECT 转发。
RAPIP_PROXY_HTTP_PORT=8888

# ---------- Docker 在宿主机的发布范围 ----------
# 管理端口发布地址；127.0.0.1 仅本机/SSH 隧道访问，0.0.0.0 为所有 IPv4 网卡。
# 与容器内部监听地址不同；脚本不会自动公开管理入口或修改防火墙。
RAPIP_ADMIN_BIND_IP=127.0.0.1
# 两个代理端口的发布地址；远程直连可改为 0.0.0.0 并限制允许来源。
# 默认仅本机，客户端可使用脚本输出的 SSH 转发命令。
RAPIP_PROXY_BIND_IP=127.0.0.1
# 旧版通用发布地址的兼容项；仅在对应 ADMIN/PROXY_BIND_IP 留空时作为后备。
RAPIP_BIND_IP=127.0.0.1

# ---------- 提供给客户端的地址/NAT 端口 ----------
# 客户端能访问的服务器 IP 或域名，只填主机名，不含协议、端口或路径。
# 留空时，页面弹窗默认使用当前页面主机名；SSH 隧道访问可用 127.0.0.1。
RAPIP_PUBLIC_PROXY_HOST=
# 可选：NAT 对外 SOCKS5 端口；留空沿用 RAPIP_SOCKS_PORT，不改变实际监听。
RAPIP_PUBLIC_SOCKS_PORT=
# 可选：NAT 对外 HTTP 代理端口；留空沿用 RAPIP_PROXY_HTTP_PORT。
RAPIP_PUBLIC_HTTP_PROXY_PORT=

# ---------- 持久化路径与页面产物 ----------
# SQLite 状态、流量快照及部署信息目录；相对当前工作目录。
# Docker 挂载固定为 ./data:/app/data，容器部署请保留 data；改路径需同步改挂载。
RAPIP_DATA_DIR=data
# 上游账号与私有密钥文件目录；容器挂载固定 ./config:/app/config，请保留 config。
RAPIP_CONFIG_DIR=config
# 管理页面构建产物目录；镜像已打包在 web/dist，通常无需修改。
RAPIP_WEB_DIR=web/dist

# ---------- 登录、网络与测活 ----------
# 是否给登录 Cookie 添加 Secure；HTTPS 反向代理设 true，HTTP/SSH 隧道设 false。
# 在普通 HTTP 下设 true 会导致浏览器无法保持登录。
RAPIP_COOKIE_SECURE=false
# 原生运行可选的上游网络跳转代理 URL；留空直连 Webshare，不继承系统代理。
# 只改变到供应商的路径，不改变业务出口；不要误填 RapIP 自己的代理入口。
RAPIP_EGRESS_PROXY=
# Docker 专用上游跳转代理 URL；Compose 用它覆盖容器内 RAPIP_EGRESS_PROXY。
# 留空即容器直连；容器的 127.0.0.1 不是宿主机，通常无需填写。
RAPIP_CONTAINER_EGRESS_PROXY=
# 首次初始化的主动测活默认开关：true 开启，false 关闭。
# 页面开关保存到 SQLite 后优先，重启保留；关闭不会自动信任未验证节点。
RAPIP_PROBE_ENABLED=true
